# =============================================================================
# Plugin: FMOD Studio Unity Integration
# =============================================================================

# Preserve FMOD DLLs, images, and gizmos
!/[Aa]ssets/Plugins/FMOD/**/lib/*
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore FMOD cache (updated locally)
/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore built bank files in StreamingAssets
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# FMOD editor log
fmod_editor.log
