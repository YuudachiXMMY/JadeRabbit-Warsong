  "_meta": {
    "title": "玉兔:破阵 · 角色动物选定寓意数据表 (Animal Roster)",
    "version": 1,
    "status": "canon",
    "created": "2026-07-13",
    "author": "Cowork",
    "companion_doc": "design/worldbuilding/setting-proposal-v2.md",
    "purpose": "结构化的动物阵容 + 寓意 + 讽刺解读，供评审与后续导入。经确认后合并进 design/registry/entities.yaml，敌人数值字段（health/damage 等）由后续 EnemyInfoSO 补齐。",
    "field_notes": {
      "category": "protagonist | enemy_martial(武官兽) | official_civil(文官禽) | censor(监察) | npc | boss_candidate",
      "has_buzi": "核心讽刺机制：true=体制内=敌，false=体制外=友/主角。视觉上以身上有无补子瞬间区分敌我与阶级。",
      "difficulty_tier": "仅 enemy_martial 使用，1=最弱，7=最强，等于补子官阶由低到高。",
      "dynasty_note": "补子鸟兽的具体分配明清略有出入，本表以常见明制为准，属设定选择而非史实错误。"
    },
    "thematic_axes": [
      "阶级：长生药机器（谁劳作/谁送死/谁永生）",
      "反战：破阵乐的反讽（一将功成万骨枯；要破战争机器须自成兵器）",
      "循环：兔死狗烹（权力用完即弃其工具）"
    ],
    "era_framework": "架空复合天朝：宋院体画美术 + 明补子制度 + 唐破阵乐 + 辛弃疾苍凉基调",
    "core_rule": "有补子=体制内=敌；无补子/劳役牲口=体制外=友或主角。"
  },

  "protagonist": [
    {
      "id": "jade-rabbit",
      "name_cn": "玉兔",
      "name_en": "Jade Rabbit",
      "category": "protagonist",
      "has_buzi": false,
      "buzi_rank": null,
      "real_animal": "兔",
      "symbolism": "玉兔捣药（汉乐府《董逃行》）：跪地以玉杵捣不死药供上层长生；象征长生、生命力、祥瑞。",
      "satirical_reading": "永生机器最底层的劳工。放下药杵、拿起兵器即阶级反抗；无补子、不在等级内，故有资格破阵。亦是兔死狗烹里那只拒绝被烹的狡兔。",
      "narrative_role": "反英雄主角，被逼反抗的劳工，非天选之子。",
      "weapon_motif": "苗刀=开了刃的捣药杵；长枪/剑为后续。",
      "art_note": "沿用 art-bible：朱砂袍、月白内衬、长耳剪影、皮影动作弧线，全部保留。",
      "mvp": true,
      "status": "active"
    }
  ],

